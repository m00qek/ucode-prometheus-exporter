          "range": true,
          "refId": "A"
        }
      ],
      "title": "Scrapes answered",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Collectors the scrape deadline left out, or whose program it killed.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
