    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Scrapes the exporter answered per minute, every scraper's, LuCI's and check's included.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
