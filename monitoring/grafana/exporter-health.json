          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_scrape_collector_duration_seconds{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "{{collector}}",
          "range": true,
          "refId": "A"
        }
