          },
          "expr": "increase(ucode_prometheus_exporter_deadline_skips_total{job=\"$job\", instance=\"$instance\"}[$__rate_interval]) > 0",
          "legendFormat": "{{collector}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Left out at the deadline",
