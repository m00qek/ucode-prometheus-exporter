{
	"luci-app-prometheus-exporter": {
		"description": "Grant access to the Prometheus exporter's settings and status",
		"read": {
			"ubus": {
				"prometheus-exporter": [ "collectors", "interfaces", "status", "validate" ]
			},
			"uci": [ "prometheus-exporter" ]
		},
		"write": {
			"ubus": {
				"prometheus-exporter": [ "hash_password" ]
			},
			"uci": [ "prometheus-exporter" ]
		}
	}
}
