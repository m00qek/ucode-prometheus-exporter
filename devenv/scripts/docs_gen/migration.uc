'use strict';

// docs/reference/migration.md: the feed's exporters' packages and metric
// families, and this exporter's for each, from what make feed-inventory read
// of their sources (docs/gen/feed-exporters.json), what the collectors write
// (docs-gen's harvest, as metrics.md has it), and docs/gen/migration.uc, the
// mapping, into the page's text, docs/gen/migration.md, at its {{...}}
// places. See docs/gen/migration.uc for what it refuses.

import * as md from 'docs_gen.markdown';

export const NOTES = 'docs/gen/migration.uc';
export const INVENTORY = 'docs/gen/feed-exporters.json';
export const TEMPLATE = 'docs/gen/migration.md';

const HEADER = '<!-- Generated by `make docs-gen` (devenv/scripts/docs-gen.uc) from docs/gen/migration.md, docs/gen/migration.uc, docs/gen/feed-exporters.json (make feed-inventory) and the collectors. Do not edit: `make lint` fails when it is out of date. -->';
const EXPORTERS = [ 'lua', 'ucode' ];
const TITLES = { lua: 'Lua', ucode: 'ucode' };
const KINDS = [ 'same', 'renamed', 'relabeled', 'missing' ];

function sorted_set(list) {
	return sort(uniq(list ?? []));
}

function same_set(a, b) {
	return join(',', sorted_set(a)) == join(',', sorted_set(b));
}

// { name: { type, labels } } of every family this exporter writes: what the
// collectors wrote on the captures, the families the notes list from the
// code, and each row of the notes' metric_patterns, its labels those of the
// families it takes.
export function our_families(ctx) {
	let out = {};

	function add(name, type, labels) {
		let f = out[name] ??= { type, labels: [] };

		for (let l in labels ?? [])
			if (!(l in f.labels))
				push(f.labels, l);
	}

	for (let f in ctx.harvest.own)
		add(f.name, f.type, f.labels);

	for (let c in ctx.collectors) {
		let name = c.meta.name;
		let families = ctx.harvest.families[name] ?? [];

		for (let f in families) {
			let p = filter(ctx.notes.metric_patterns[name] ?? [], (p) => p.match(f.name))[0];

			if (p)
				add(p.name, p.type ?? f.type, f.labels);
			else
				add(f.name, f.type, f.labels);
		}

		for (let u in ctx.notes.unharvested[name] ?? [])
			add(u.name, null, u.labels);
	}

	return out;
};

// The families of `ours` a mapping's `to` names: the family of that name, or
// for a name with <...> parts, each family whose name has anything there.
export function resolve(ours, to) {
	if (ours[to])
		return [ ours[to] ];
	if (index(to, '<') < 0)
		return [];

	let parts = map(split(to, /<[^>]*>/), (p) => replace(p, /[.*+?^${}()|[\]\\]/g, (c) => `\\${c}`));
	let re = regexp(`^${join('.+', parts)}$`);

	return map(filter(keys(ours), (n) => match(n, re)), (n) => ours[n]);
};

function targets(entry) {
	return entry.to == null ? [] : (type(entry.to) == 'array' ? entry.to : [ entry.to ]);
}

function labels_of(entry, exporter) {
	return type(entry.labels) == 'object' ? entry.labels[exporter] : entry.labels;
}

// The kind of change of a family of `exporter`, `name`, mapped by `entry`.
function kind(ours, name, entry, exporter) {
	let to = targets(entry);

	if (!length(to))
		return 'missing';
	if (to[0] != name)
		return 'renamed';

	let labels = [];

	for (let f in resolve(ours, to[0]))
		push(labels, ...f.labels);
	if (!same_set(labels_of(entry, exporter), labels))
		return 'relabeled';

	return entry.change ?? 'same';
}

function ours_cell(ours, entry) {
	let to = targets(entry);

	if (!length(to))
		return '—';

	return join('<br>', map(to, function(t) {
		let labels = [];

		for (let f in resolve(ours, t))
			for (let l in f.labels)
				if (!(l in labels))
					push(labels, l);

		return md.code(length(labels) ? `${t}{${join(',', labels)}}` : t);
	}));
}

// { name, by: { exporter: { type, collector } } } of each family of the
// feed's collector `id`, in the order of their names; problems for one the
// notes do not map, or whose labels its source has no key for.
function feed_families(inv, notes, id, problems) {
	let rows = {};

	for (let e in EXPORTERS) {
		let c = inv.exporters[e].collectors[id];

		for (let f in c?.families ?? []) {
			let name = notes.computed[f.name] ?? f.name;
			let entry = notes.families[name];

			if (!entry) {
				push(problems, `migration: ${e} ${id} writes ${name}, which docs/gen/migration.uc does not map`);
				continue;
			}

			for (let l in labels_of(entry, e) ?? [])
				if (!(l in c.keys))
					push(problems, `migration: ${e} ${id}: ${name}: its source has no label ${l}`);

			(rows[name] ??= { name, by: {} }).by[e] = { type: f.type };
		}
	}

	return sort(values(rows), (a, b) => a.name < b.name ? -1 : a.name > b.name ? 1 : 0);
}

function family_rows(ctx, inv, notes, ours, problems, counts, aliases) {
	let blocks = [];
	let ids = [];

	for (let e in EXPORTERS)
		for (let id in keys(inv.exporters[e].collectors))
			if (!(id in ids))
				push(ids, id);

	ids = sort(ids, (a, b) => a == '(scrape)' ? -1 : b == '(scrape)' ? 1 : (a < b ? -1 : a > b ? 1 : 0));

	for (let id in ids) {
		let rows = [];

		for (let r in feed_families(inv, notes, id, problems)) {
			let entry = notes.families[r.name];
			let kinds = {}, cells = {};

			for (let t in targets(entry))
				if (!length(resolve(ours, t)))
					push(problems, `migration: ${r.name}: this exporter writes no ${t}`);

			for (let e in EXPORTERS) {
				if (!r.by[e]) {
					cells[e] = '—';
					continue;
				}

				let labels = labels_of(entry, e);

				if (labels == null)
					push(problems, `migration: ${r.name}: no labels for the ${e} exporter`);
				cells[e] = md.code(length(labels) ? `{${join(',', labels)}}` : 'no labels');
				kinds[e] = kind(ours, r.name, entry, e);
				counts[e][kinds[e]]++;

				let to = targets(entry);

				if (entry.alias && length(to) == 1 && to[0] != r.name &&
				    same_set(labels, resolve(ours, to[0])[0]?.labels))
					aliases[r.name] = to[0];
			}

			let present = filter(EXPORTERS, (e) => kinds[e]);
			let change = length(uniq(map(present, (e) => kinds[e]))) == 1
				? kinds[present[0]]
				: join('; ', map(present, (e) => `${TITLES[e]}: ${kinds[e]}`));
			let notes_cell = [];
			let first = resolve(ours, targets(entry)[0] ?? '')[0];

			if (entry.note)
				push(notes_cell, md.text(entry.note));
			for (let e in present)
				if (first?.type && r.by[e].type && first.type != r.by[e].type)
					push(notes_cell, `Type ${r.by[e].type} → ${first.type}.`);

			push(rows, [ md.code(r.name), cells.lua, cells.ucode, ours_cell(ours, entry), change, join(' ', uniq(notes_cell)) ]);
		}

		let where = join(' and ', map(filter(EXPORTERS, (e) => inv.exporters[e].collectors[id]), (e) => TITLES[e]));
		let ours_name = id in notes.collectors ? notes.collectors[id] : id;
		let title = id == '(scrape)' ? 'The scrape\'s own' : md.code(id);
		let intro = id == '(scrape)'
			? `The ${where} exporters', of every collector a scrape ran.`
			: `The ${where} exporter's; here, [${md.code(ours_name)}](collectors.md#${md.anchor(ours_name)})'s.`;

		push(blocks, md.heading(3, title, `from-${md.anchor(id == '(scrape)' ? 'scrape' : id)}`), intro,
			md.table([ 'Family', 'Lua', 'ucode', 'Here', 'Change', 'Notes' ], rows));
	}

	return blocks;
}

function package_rows(ctx, inv, notes, problems) {
	let names = map(ctx.collectors, (c) => c.meta.name);
	let place_of = {};
	let mapped = {};
	let rows = [];

	for (let c in ctx.collectors)
		place_of[c.meta.name] = ctx.places[c.id];

	for (let e in EXPORTERS) {
		let ex = inv.exporters[e];

		for (let p in sort(keys(ex.packages))) {
			let ours = [], mirror = true;

			for (let id in ex.packages[p]) {
				let name = id in notes.collectors ? notes.collectors[id] : id;

				if (name == null)
					continue;
				if (!(name in names)) {
					push(problems, `migration: ${p}'s ${id} is no collector of this exporter: name it in collectors`);
					continue;
				}

				let place = place_of[name];

				mapped[place.package] = true;
				if (!(place.package in ours))
					push(ours, place.package);

				let suffix = substr(p, length(ex.package) + 1);

				if (place.base ? p != ex.package : suffix != substr(place.package, length(ctx.pkg.name) + 1))
					mirror = false;
			}

			let note = notes.packages[p];

			if (note)
				mirror = false;
			push(rows, [ md.code(p), length(ours) ? md.codes(ours) : '—', mirror ? 'yes' : 'no', note ? md.text(note) : '' ]);
		}
	}

	for (let p in keys(notes.packages))
		if (!filter(EXPORTERS, (e) => inv.exporters[e].packages[p]))
			push(problems, `migration: packages: the feed has no ${p}`);

	let extra = [];

	for (let id in sort(keys(ctx.pkg.collectors))) {
		let p = `${ctx.pkg.name}-${ctx.pkg.collectors[id].name}`;

		if (!mapped[p])
			push(extra, p);
	}

	return { table: md.table([ 'Feed package', 'Here', 'Same name', 'Notes' ], rows), extra };
}

function summary(counts) {
	let rows = [];

	for (let k in KINDS)
		push(rows, [ k, `${counts.lua[k]}`, `${counts.ucode[k]}` ]);
	push(rows, [ 'all', `${counts.lua.same + counts.lua.renamed + counts.lua.relabeled + counts.lua.missing}`,
		`${counts.ucode.same + counts.ucode.renamed + counts.ucode.relabeled + counts.ucode.missing}` ]);

	return md.table([ 'Change', 'Lua exporter\'s families', 'ucode exporter\'s families' ], rows);
}

function relabel(aliases) {
	let lines = [ '```yaml', 'metric_relabel_configs:' ];

	for (let from in sort(keys(aliases)))
		push(lines,
			'  - source_labels: [__name__]',
			`    regex: ${from}`,
			'    target_label: __name__',
			`    replacement: ${aliases[from]}`);
	push(lines, '```');

	return join('\n', lines);
}

// { text, problems } of the page.
export function migration_page(ctx) {
	let m = ctx.migration;
	let inv = m.inventory, notes = m.notes;
	let problems = [];
	let ours = our_families(ctx);
	let counts = {}, aliases = {}, used = {};

	for (let e in EXPORTERS) {
		counts[e] = { same: 0, renamed: 0, relabeled: 0, missing: 0 };
		for (let id, c in inv.exporters[e].collectors)
			for (let f in c.families)
				used[notes.computed[f.name] ?? f.name] = true;
	}

	for (let name in keys(notes.families))
		if (!used[name])
			push(problems, `migration: neither feed exporter writes ${name}: take it out of docs/gen/migration.uc`);
	for (let id in keys(notes.collectors))
		if (!filter(EXPORTERS, (e) => inv.exporters[e].collectors[id]))
			push(problems, `migration: collectors: the feed has no collector ${id}`);

	let families = family_rows(ctx, inv, notes, ours, problems, counts, aliases);
	let packages = package_rows(ctx, inv, notes, problems);
	let fill = {
		source: `${md.code(inv.exporters.lua.package)} ${inv.exporters.lua.version} and ${md.code(inv.exporters.ucode.package)} ${inv.exporters.ucode.version}, from ${md.code(inv.source)}`,
		summary: summary(counts),
		packages: packages.table,
		extra: md.codes(packages.extra),
		families: join('\n\n', families),
		relabel: relabel(aliases),
	};
	let text = replace(m.template, /\{\{([a-z]+)\}\}/g, function(all, key) {
		if (fill[key] == null)
			push(problems, `migration: ${TEMPLATE} has {{${key}}}, which the generator does not fill`);

		return fill[key] ?? all;
	});

	return { text: `${HEADER}\n\n${text}`, problems: uniq(problems) };
};
