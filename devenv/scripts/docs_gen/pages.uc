'use strict';

// The generated reference pages, from what docs-gen.uc gathered (ctx):
//
//   pkg         docs_gen.package's parse() of the package Makefile
//   collectors  the loaded collectors ({ id, meta }), sorted by name
//   sources     { id: the collector module's text }
//   harvest     docs_gen.harvest's harvest() of the fixture sets
//   notes       docs/gen/notes.uc
//   errors      errors.uc's text
//   raisers     { path: text } of the modules and programs that raise errors
//
// Each page function returns { text, problems }: the page, and what in the
// notes the code contradicts, which docs-gen refuses.

import * as config from 'prometheus_exporter.config';
import * as services from 'prometheus_exporter.services';
import * as jail from 'prometheus_exporter.jail';
import * as md from 'docs_gen.markdown';
import * as source from 'docs_gen.source';

const HEADER = '<!-- Generated by `make docs-gen` (devenv/scripts/docs-gen.uc) from the code, with docs/gen/notes.uc. Do not edit: `make lint` fails when it is out of date. -->';

// A default as uci holds it.
function uci_value(v) {
	switch (type(v)) {
	case 'bool': return v ? '1' : '0';
	case 'int': return `${v}`;
	}

	return v;
}

function default_cell(v) {
	return (v === '' || v == null) ? 'unset' : md.code(uci_value(v));
}

const TYPES = { bool: 'boolean', int: 'integer', string: 'string' };

// One row of an options table: name, type, default, datatype, help.
function option_row(name, spec, dflt) {
	return [
		md.code(name),
		TYPES[type(dflt ?? spec.default)],
		default_cell(dflt ?? spec.default),
		spec.datatype ? md.code(spec.datatype) : null,
		md.text(spec.help),
	];
}

// ---- collectors.md ------------------------------------------------------------

function package_cell(p) {
	return p ? md.code(p.package) + (p.base ? ' (base)' : '') : 'not packaged';
}

// What a path of meta.paths gives with the collector's default options.
function path_cells(c, notes, problems) {
	let out = [];
	let defaults = config.defaults(c.meta.options ?? {});

	for (let p in c.meta.paths ?? []) {
		if (type(p) == 'function') {
			let note = notes.computed_paths[c.meta.name];

			if (note)
				push(out, md.text(note));
			else
				push(problems, `${c.meta.name}: meta.paths has a function; say what it gives in computed_paths`);
			continue;
		}

		let owned = (type(p) == 'object');
		let path = jail.fill(owned ? p.path : p, defaults);
		let template = owned ? p.path : p;
		let shown = md.code(path) + ((template != path) ? ` (${md.code(template)})` : '');

		push(out, shown + (owned ? ', which the service makes when it is not there' : ''));
	}

	return out;
}

function seconds_cell(c) {
	if (!('exec' in c.meta.needs))
		return null;

	return (c.meta.timeout != null)
		? `${c.meta.timeout}, its own default (\`meta.timeout\`), unless its section sets \`timeout\``
		: 'The main section\'s `exec_timeout`, unless its section sets `timeout`';
}

function collector_options(c) {
	let rows = [];
	let core = config.core(c.meta, ('exec' in c.meta.needs) ? (c.meta.timeout ?? config.EXEC_TIMEOUT) : null);

	for (let name, spec in c.meta.options ?? {})
		push(rows, option_row(name, spec));

	push(rows, option_row('enabled', core.enabled));

	if (core.timeout) {
		let row = option_row('timeout', core.timeout);

		row[2] = (c.meta.timeout != null) ? md.code(c.meta.timeout) : `\`exec_timeout\`'s (${config.EXEC_TIMEOUT})`;
		push(rows, row);
	}

	return md.table([ 'Option', 'Type', 'Default', 'Datatype', 'Description' ], rows);
}

function collector_section(ctx, c, problems) {
	let meta = c.meta;
	let p = ctx.places[c.id];
	let none = ctx.notes.nothing_to_observe[meta.name];
	let facts = [
		`- **Title:** ${md.text(meta.title)}`,
		`- **Package:** ${package_cell(p)}`,
	];

	if (p && length(p.groups))
		push(facts, `- **In the groups:** ${md.codes(p.groups)}`);
	if (p && length(p.depends))
		push(facts, `- **Depends on:** ${md.codes(map(p.depends, (d) => replace(d, /^\+/, '')))}`);

	push(facts, `- **Section:** ${md.code(`config collector '${c.id}'`)}`);
	push(facts, `- **Needs:** ${md.codes(meta.needs)}`);

	if (length(meta.configs ?? []))
		push(facts, `- **Reads the configs:** ${md.codes(map(meta.configs, (n) => `${jail.CONFIG_DIR}/${n}`))}`);
	if (length(meta.commands ?? []))
		push(facts, `- **Runs:** ${join(', ', map(meta.commands, (cmd) => md.code(cmd) +
			((cmd in (meta.optional_commands ?? [])) ? ' (only where it is installed)' : '')))}, with ${md.code(jail.SHELL)}`);

	let paths = path_cells(c, ctx.notes, problems);

	if (length(paths))
		push(facts, `- **Jail paths:** ${join('; ', paths)}`);

	let seconds = seconds_cell(c);

	if (seconds)
		push(facts, `- **Seconds for its programs:** ${seconds}`);
	if (meta.max_samples != null)
		push(facts, `- **Samples it may write:** ${meta.max_samples}, its own (\`meta.max_samples\`), unless its section sets \`max_samples\``);
	if (meta.cost == 'heavy')
		push(facts, '- **Cost:** heavy (`meta.cost`): until the ledger has timed it, it runs after the others');
	if (none)
		push(facts, `- **Nothing to observe:** ${md.text(none.when)} See [Nothing to observe](#nothing-to-observe).`);

	push(facts, `- **Metrics:** [${md.text(meta.name)}](metrics.md#${md.anchor(meta.name)})`);

	return [
		md.heading(2, md.code(meta.name), md.anchor(meta.name)),
		md.text(meta.help),
		join('\n', facts),
		collector_options(c),
	];
}

export function collectors_page(ctx) {
	let problems = [];
	let blocks = [ HEADER, '# Collectors' ];
	let pkg = ctx.pkg;

	push(blocks,
		`Every collector of ${md.code(`${pkg.name} ${pkg.version}`)}. A collector's name is what a scrape's ` +
		'`collect[]=` takes and the suffix of its package; its section in `/etc/config/prometheus-exporter` ' +
		'is named after its module, the name with `_` for `-`. Its options are in that section; ' +
		'[UCI configuration](uci-config.md#collector-sections) has the section\'s rules.');

	let rows = map(ctx.collectors, (c) => [
		`[${md.code(c.meta.name)}](#${md.anchor(c.meta.name)})`,
		md.text(c.meta.title),
		package_cell(ctx.places[c.id]),
		md.codes(ctx.places[c.id]?.groups ?? []),
	]);

	push(blocks, md.table([ 'Collector', 'Title', 'Package', 'Groups' ], rows));

	push(blocks, md.heading(2, 'Packages', 'packages'));
	push(blocks,
		`The base package, ${md.code(pkg.name)}, installs ${md.codes(map(sort([ ...pkg.base ]), (id) => ctx.name_of[id] ?? id))}. ` +
		`Every other collector is a package of its own, ${md.code(`${pkg.name}-<name>`)}, which depends on the base package of the same release. ` +
		'A group package installs no files, only its collectors.');

	push(blocks, md.table([ 'Group package', 'For', 'Collectors' ], map(pkg.groups, (g) => [
		md.code(`${pkg.name}-${g.name}`), md.text(g.purpose), md.codes(g.members),
	])));

	let ungrouped = filter(ctx.collectors, (c) => ctx.places[c.id] && !ctx.places[c.id].base && !length(ctx.places[c.id].groups));

	push(blocks, `In no group: ${md.codes(map(ungrouped, (c) => c.meta.name))}.`);

	push(blocks, md.heading(2, 'Nothing to observe', 'nothing-to-observe'));
	push(blocks,
		'These collectors can have nothing to observe: they succeed without samples, and their ' +
		'`node_scrape_collector_observing` is 0. Every other collector fails when it cannot read what it reads. ' +
		'The reasons are what `check`, the ubus object\'s `status` and LuCI\'s status page show.');

	let none_rows = [];
	let states = [ services.DISABLED, services.NOT_INSTALLED ];

	for (let c in ctx.collectors) {
		let note = ctx.notes.nothing_to_observe[c.meta.name];
		let code_has = source.has_none(ctx.sources[c.id]);

		if (note && !code_has)
			push(problems, `nothing_to_observe: ${c.meta.name}'s code never answers nothing to observe`);
		if (!note && code_has)
			push(problems, `nothing_to_observe: ${c.meta.name} can answer nothing to observe; say when`);
		if (!note)
			continue;

		let reasons = note.reasons ?? source.reasons(ctx.sources[c.id], states);

		for (let r in note.reasons ?? [])
			if (index(ctx.sources[c.id], r) < 0)
				push(problems, `nothing_to_observe: ${c.meta.name}'s code never gives the reason '${r}'`);

		push(none_rows, [
			`[${md.code(c.meta.name)}](#${md.anchor(c.meta.name)})`,
			md.text(note.when),
			md.codes(reasons),
			md.text(note.failure),
		]);
	}

	for (let name in keys(ctx.notes.nothing_to_observe))
		if (!(name in map(ctx.collectors, (c) => c.meta.name)))
			push(problems, `nothing_to_observe: no collector ${name}`);

	push(blocks, md.table([ 'Collector', 'Nothing to observe when', 'Reasons it gives', 'Still a failure' ], none_rows));

	for (let c in ctx.collectors)
		push(blocks, ...collector_section(ctx, c, problems));

	for (let name in keys(ctx.notes.computed_paths)) {
		let c = filter(ctx.collectors, (c) => c.meta.name == name)[0];

		if (!c || !length(filter(c.meta.paths ?? [], (p) => type(p) == 'function')))
			push(problems, `computed_paths: ${name} has no function in meta.paths`);
	}

	return { text: md.page(blocks), problems };
};

// ---- metrics.md ---------------------------------------------------------------

// The rows of one collector's families: each pattern of the notes takes the
// families it matches, in the place of the first.
function metric_rows(families, patterns, name, problems) {
	let rows = [];
	let taken = {};

	for (let f in families) {
		let p = null;

		for (let candidate in patterns)
			if (candidate.match(f.name)) {
				p = candidate;
				break;
			}

		if (!p) {
			push(rows, f);
			continue;
		}

		let row = taken[p.name];

		if (!row) {
			row = taken[p.name] = {
				name: p.name, pattern: true, types: [], labels: [], help: p.help, options: [], count: 0, unharvested: false,
				type_text: p.type, labels_text: p.labels,
			};
			push(rows, row);
		}

		row.count++;
		if (!(f.type in row.types))
			push(row.types, f.type);
		for (let l in f.labels)
			if (!(l in row.labels))
				push(row.labels, l);
	}

	for (let p in patterns)
		if (!taken[p.name])
			push(problems, `metric_patterns: ${name}: ${p.name} takes no family the fixtures show`);

	return rows;
}

function note_cell(f) {
	let out = [];

	if (f.note)
		push(out, md.text(f.note));
	if (f.pattern)
		push(out, `${f.count} on the captures`);
	if (length(f.options ?? []))
		push(out, `With ${md.codes(f.options)}`);
	if (f.unharvested)
		push(out, `Listed from the code: ${md.text(f.why)}`);

	return join('; ', out);
}

function family_table(rows) {
	return md.table([ 'Family', 'Type', 'Labels', 'Help', 'Notes' ], map(rows, (f) => [
		md.code(f.name),
		f.pattern ? (f.type_text ? md.text(f.type_text) : join(', ', f.types)) : f.type,
		f.labels_text ? md.text(f.labels_text) : md.codes(f.labels, ''),
		md.text(f.help),
		note_cell(f),
	]));
}

// The families the notes list by hand for collector `c`, checked: each one
// its code declares, which no fixture shows.
function unharvested(ctx, c, harvested, problems) {
	let out = [];
	let declared = {};

	for (let d in source.declared(ctx.sources[c.id]))
		declared[d.name] = d;

	for (let u in ctx.notes.unharvested[c.meta.name] ?? []) {
		let d = declared[u.name];

		if (!d)
			push(problems, `unharvested: ${c.meta.name} declares no family ${u.name}`);
		else if (u.name in harvested)
			push(problems, `unharvested: the fixtures show ${c.meta.name}'s ${u.name}; take it out of the notes`);
		else
			push(out, { name: u.name, type: d.type, labels: u.labels, help: d.help ?? '', unharvested: true, why: u.why, options: [] });
	}

	let listed = map(out, (f) => f.name);

	for (let name in keys(declared))
		if (!(name in harvested) && !(name in listed))
			push(problems, `${c.meta.name} declares ${name}, which no fixture set makes it write: add a fixture, or list it in unharvested`);

	return out;
}

export function metrics_page(ctx) {
	let problems = [ ...ctx.harvest.problems ];
	let label = function(set) {
		let l = ctx.notes.capture_sets[set];

		if (l == null)
			push(problems, `capture_sets: name the fixture set ${set}`);

		return l ?? set;
	};
	let sets = map(ctx.sets, label);

	for (let set in keys(ctx.notes.capture_sets))
		if (!(set in ctx.sets))
			push(problems, `capture_sets: there is no fixture set ${set}`);
	let blocks = [ HEADER, '# Metrics' ];
	let sections = [];
	let coverage = [];

	for (let name in keys(ctx.notes.unharvested))
		if (!(name in map(ctx.collectors, (c) => c.meta.name)))
			push(problems, `unharvested: no collector ${name}`);
	for (let name in keys(ctx.notes.metric_patterns))
		if (!(name in map(ctx.collectors, (c) => c.meta.name)))
			push(problems, `metric_patterns: no collector ${name}`);
	for (let name in keys(ctx.notes.family_notes))
		if (!(name in map(ctx.collectors, (c) => c.meta.name)))
			push(problems, `family_notes: no collector ${name}`);

	for (let c in ctx.collectors) {
		let name = c.meta.name;
		let families = ctx.harvest.families[name] ?? [];
		let harvested = map(families, (f) => f.name);
		let extra = unharvested(ctx, c, harvested, problems);
		let rows = [ ...metric_rows(families, ctx.notes.metric_patterns[name] ?? [], name, problems), ...extra ];

		for (let n in ctx.notes.family_notes[name] ?? []) {
			let taken = filter(rows, (r) => n.match(r.name));

			if (!length(taken))
				push(problems, `family_notes: ${name}: a note takes no family the fixtures show`);
			for (let r in taken)
				r.note = n.note;
		}
		let seen = [];

		for (let f in families)
			for (let s in f.sets)
				if (!(s in seen))
					push(seen, s);

		if (!length(rows))
			push(problems, `${name} writes no family on any fixture set, and the notes list none`);

		push(coverage, [
			`[${md.code(name)}](#${md.anchor(name)})`,
			`${length(families)}`,
			length(seen) ? join(', ', map(sort(seen), (s) => md.text(label(s)))) : 'none',
			length(extra) ? md.codes(map(extra, (f) => f.name)) : null,
		]);

		push(sections,
			md.heading(2, md.code(name), md.anchor(name)),
			`${md.text(c.meta.title)}. [Collector](collectors.md#${md.anchor(name)}).`,
			family_table(rows));
	}

	push(blocks,
		'The metric families each collector writes, and those a scrape writes of itself. ' +
		'Types, labels and help texts are what the collectors write: each collector runs as a scrape runs it, ' +
		`on each set of captures in \`test/fixtures/\` (${join(', ', map(sets, md.text))}), with its defaults and with each ` +
		'boolean option the other way. A family that only an option writes says which.',
		'The labels are those seen on the captures; a collector leaves out a label it has no value for, ' +
		'so a device may show fewer. Families whose names hold what the source reports (a driver\'s ' +
		'statistics, a kernel table\'s fields) are one row, their name a pattern in `<>`. ' +
		'Families no capture shows are listed from the collector\'s code, and say why.',
		'[Renamed metrics](../metrics.md) lists the names that changed from the feed\'s exporters.');

	push(blocks, md.heading(2, 'Coverage', 'coverage'));
	push(blocks, md.table([ 'Collector', 'Families on the captures', 'Seen on', 'Listed from the code' ], coverage));

	push(blocks, md.heading(2, 'The scrape\'s own', 'scrape'));
	push(blocks,
		'Every scrape ends with these, whatever `collect[]` selects: node_exporter\'s families of each collector that ran, ' +
		'and the exporter\'s version.');
	push(blocks, family_table(ctx.harvest.own));

	push(blocks, ...sections);

	return { text: md.page(blocks), problems };
};

// ---- uci-config.md ------------------------------------------------------------

export function uci_page(ctx) {
	let blocks = [ HEADER, '# UCI Configuration' ];
	let used = {};
	let note_type = function(spec) {
		if (spec.datatype)
			used[spec.datatype] = true;
	};

	push(blocks,
		'The exporter\'s configuration is `/etc/config/prometheus-exporter`. The file is optional: every option ' +
		'has a default, an unset option takes it, and an option the exporter does not know is ignored. ' +
		'Changes apply on `reload_config` or `service prometheus-exporter reload`.');

	push(blocks, md.heading(2, 'The main section', 'main'));
	push(blocks,
		`\`config ${config.NAME} 'main'\`. The init script reads the first options, to start uhttpd; ` +
		'the exporter reads the others in each scrape.');

	let rows = [];

	for (let name, spec in config.SERVICE_OPTIONS) {
		note_type(spec);
		push(rows, [ ...option_row(name, spec), 'init script' ]);
	}
	for (let name, spec in config.MAIN_OPTIONS) {
		note_type(spec);
		push(rows, [ ...option_row(name, spec), 'exporter' ]);
	}

	push(blocks, md.table([ 'Option', 'Type', 'Default', 'Datatype', 'Description', 'Read by' ], rows));

	push(blocks,
		'Options that go together, checked wherever the configuration is checked (start, reload, `check`, ' +
		'the ubus object\'s `validate` and LuCI):');

	let together = config.together({ auth_user: 'u' });
	let alone = config.together({ auth_password: 'h' });
	let no_tls = config.together({ auth_user: 'u', auth_password: 'h' });

	push(blocks, join('\n', [
		`- \`auth_user\` without \`auth_password\`: ${md.text(together.auth_password)}.`,
		`- \`auth_password\` without \`auth_user\`: ${md.text(alone.auth_user)}.`,
		`- Either without \`cert\` and \`key\`: ${md.text(no_tls.auth_user)}.`,
	]));

	push(blocks, md.heading(2, 'Collector sections', 'collector-sections'));
	push(blocks,
		'`config collector \'<module>\'`, one per collector, named after its module: the collector\'s name with `_` ' +
		'for `-` (`ltq_dsl` for `ltq-dsl`), as a uci section name cannot hold `-`. A collector without a section ' +
		'runs with its defaults. A section that names no installed collector, and one without a name, is ignored ' +
		'(`check` warns of both). Besides its own options, listed in [Collectors](collectors.md), every collector has these:');

	let core = [ option_row('enabled', config.ENABLED) ];
	let t = option_row('timeout', config.TIMEOUT, config.EXEC_TIMEOUT);

	t[2] = `the collector's \`meta.timeout\`, else \`exec_timeout\` (${config.EXEC_TIMEOUT})`;
	push(core, t);
	note_type(config.TIMEOUT);

	let b = option_row('budget', config.BUDGET, config.COLLECTOR_BUDGET);

	b[2] = `\`collector_budget\` (${config.COLLECTOR_BUDGET}), or the collector's \`timeout\` and a second more when that is longer`;
	push(core, b);
	note_type(config.BUDGET);

	let n = option_row('max_samples', config.SAMPLES, config.MAX_SAMPLES);

	n[2] = `the collector's \`meta.max_samples\`, else \`max_samples\` (${config.MAX_SAMPLES})`;
	push(core, n);
	note_type(config.SAMPLES);

	push(blocks, md.table([ 'Option', 'Type', 'Default', 'Datatype', 'Description' ], core));
	push(blocks,
		'`timeout` is only for a collector that runs programs (`exec` in its needs); the others ignore it. ' +
		'A collector still running at the end of its `budget` is stopped and quarantined, and one that writes more ' +
		'than its `max_samples` fails: see [Collector contract](collector-contract.md) and ' +
		'[About deadlines and circuit breakers](../explanation/deadlines-and-breakers.md). ' +
		`No collector may declare an option named ${md.codes(config.RESERVED)}.`);

	for (let c in ctx.collectors)
		for (let name, spec in c.meta.options ?? {})
			note_type(spec);

	push(blocks, md.heading(2, 'Values', 'values'));
	push(blocks,
		`A boolean takes ${md.codes(config.TRUE)} for true and ${md.codes(config.FALSE)} for false. ` +
		'An integer is decimal digits, with an optional `-`. A string is a single value, not a list. ' +
		'A datatype narrows what an option takes, by the name LuCI gives it; the exporter checks it itself:');

	let dt_rows = [];

	for (let name in sort(keys(used))) {
		let dt = config.datatype(name);

		push(dt_rows, [ md.code(name), md.text(dt?.expected ?? 'unknown') ]);
	}

	push(blocks, md.table([ 'Datatype', 'Takes' ], dt_rows));

	push(blocks,
		'`directory` and `file` check the path\'s form, not that it exists. A value an option does not take ' +
		'is `CONFIG_INVALID`: in the main section it stops start and reload, and in a collector\'s section that ' +
		'collector fails in each scrape. See [Error codes](error-codes.md).');

	push(blocks, md.heading(2, 'Example', 'example'));
	push(blocks, '```\n' + `config ${config.NAME} 'main'\n` +
		join('', map(keys(config.SERVICE_OPTIONS), (k) => {
			let v = config.SERVICE_OPTIONS[k].default;
			return (v === '') ? '' : `\toption ${k} '${uci_value(v)}'\n`;
		})) +
		join('', map(keys(config.MAIN_OPTIONS), (k) => `\toption ${k} '${uci_value(config.MAIN_OPTIONS[k].default)}'\n`)) +
		'\nconfig collector \'textfile\'\n\toption enabled \'1\'\n\toption directory \'/var/prometheus\'\n```');

	return { text: md.page(blocks), problems: [] };
};

// ---- error-codes.md -----------------------------------------------------------

// A module of the exporter by its path among them (exposition/parse.uc), a
// collector or a program by its file's name.
const LIBRARY = 'src/prometheus_exporter/';

function module_name(path) {
	if (substr(path, 0, length(LIBRARY)) == LIBRARY && index(path, '/collectors/') < 0)
		return substr(path, length(LIBRARY));

	return replace(path, /^.*\//, '');
}

export function errors_page(ctx) {
	let problems = [];
	let blocks = [ HEADER, '# Error Codes' ];
	let groups = source.error_codes(ctx.errors);
	let all = [];

	push(blocks,
		'A failure carries an uppercase code, from `src/prometheus_exporter/errors.uc`, and a detail. ' +
		'It is written `CODE (detail)`, or `CODE` alone without one: in the log ' +
		'(`collector \'<name>\': CODE (detail)`, see [Log messages](log-messages.md)), in `check`, in the ubus object\'s ' +
		'replies and on LuCI\'s status page. A collector that fails has `node_scrape_collector_success` 0.');

	for (let g in groups) {
		push(blocks, md.heading(2, md.text(g.group)));

		let rows = [];

		for (let code in g.codes) {
			push(all, code);

			let meaning = ctx.notes.errors[code];

			if (meaning == null)
				push(problems, `errors: say what ${code} means`);

			let core = [];
			let collectors = [];

			for (let path in sort(keys(ctx.raisers)))
				if (source.raises(ctx.raisers[path], code))
					push(index(path, '/collectors/') >= 0 ? collectors : core, module_name(path));

			let raised = [];

			if (length(core))
				push(raised, md.codes(core));
			if (length(collectors))
				push(raised, `the ${length(collectors) == 1 ? 'collector' : 'collectors'} ${md.codes(map(collectors, (f) => ctx.name_of[replace(f, /\.uc$/, '')] ?? f))}`);

			push(rows, [ md.code(code), md.text(meaning), join('; ', raised) ]);
		}

		push(blocks, md.table([ 'Code', 'Meaning', 'Raised by' ], rows));
	}

	for (let code in keys(ctx.notes.errors))
		if (!(code in all))
			push(problems, `errors: errors.uc has no ${code}`);

	return { text: md.page(blocks), problems };
};

// ---- command.md ---------------------------------------------------------------

// The commands of a docopt usage text: the words that start each pattern of
// its Usage: section, before any option or argument ('scrape', 'collector
// list'); the patterns of options alone (-h, --version) are none.
export function usage_commands(usage) {
	let out = [];
	let inside = false;

	for (let line in split(usage, '\n')) {
		if (line == 'Usage:') {
			inside = true;
			continue;
		}
		if (!inside)
			continue;
		if (trim(line) == '')
			break;

		let words = slice(split(trim(line), /\s+/), 1);
		let cmd = [];

		for (let w in words) {
			if (!match(w, /^[a-z][a-z-]*$/))
				break;
			push(cmd, w);
		}

		if (length(cmd) && !(join(' ', cmd) in out))
			push(out, join(' ', cmd));
	}

	return out;
};

export function command_page(ctx) {
	let problems = [];
	let notes = ctx.notes.command;
	let blocks = [ HEADER, '# The `prometheus-exporter` Command', md.text(notes.intro), '```\n' + trim(ctx.usage) + '\n```' ];
	let cmds = usage_commands(ctx.usage);

	push(blocks, md.text(notes.usage));

	for (let cmd in cmds) {
		let n = notes.commands[cmd];

		if (n == null) {
			push(problems, `command: say what \`${cmd}\` does`);
			continue;
		}

		push(blocks, md.heading(2, md.code(`prometheus-exporter ${cmd}`), md.anchor(replace(cmd, ' ', '-'))));
		push(blocks, md.text(n.does));
		if (length(n.notes ?? []))
			push(blocks, join('\n', map(n.notes, (l) => `- ${md.text(l)}`)));
		push(blocks, md.table([ 'Exit status', 'When' ], map(n.exit, (e) => [ md.code(e[0]), md.text(e[1]) ])));
		if (n.example)
			push(blocks, '```\n' + n.example + '\n```');
	}

	for (let cmd in keys(notes.commands))
		if (!(cmd in cmds))
			push(problems, `command: the usage has no \`${cmd}\``);

	push(blocks, md.heading(2, 'Everywhere', 'everywhere'));
	push(blocks, join('\n', map(notes.everywhere, (l) => `- ${md.text(l)}`)));

	return { text: md.page(blocks), problems };
};
