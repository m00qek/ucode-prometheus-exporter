#!/bin/sh /etc/rc.common

START=60
USE_PROCD=1

NAME=prometheus-node-exporter-ucode
HANDLER=/usr/libexec/$NAME/handler.uc

_log() {
	logger -p daemon.info -t "$NAME" "$@"
}

start_service() {
	. /lib/functions/network.sh

	local interface port keepalive cert key listen bind4 bind6

	config_load "$NAME"
	config_get interface main listen_interface loopback
	config_get port main listen_port 9101
	config_get keepalive main http_keepalive 70
	config_get cert main cert
	config_get key main key

	[ "$interface" = "*" ] || {
		network_get_ipaddr bind4 "$interface"
		network_get_ipaddr6 bind6 "$interface"
		[ -n "$bind4$bind6" ] || {
			_log "deferring start until listen interface $interface becomes ready"
			return 0
		}
	}

	procd_open_instance

	procd_set_param command /usr/sbin/uhttpd -f -c /dev/null -h /dev/null -S -D -o /metrics -O "$HANDLER"
	[ "$keepalive" -gt 0 ] && procd_append_param command -k "$keepalive"

	if [ -f "$cert" ] && [ -f "$key" ]; then
		listen=-s
		procd_append_param command -C "$cert" -K "$key"
	else
		listen=-p
	fi

	if [ "$interface" = "*" ]; then
		procd_append_param command $listen "$port"
	else
		[ -n "$bind4" ] && procd_append_param command $listen "$bind4:$port"
		[ -n "$bind6" ] && procd_append_param command $listen "[$bind6]:$port"
	fi

	procd_add_jail "$NAME" log procfs sysfs ubus
	procd_add_jail_mount /usr/lib/uhttpd_ucode.so /lib/libubus.so* /lib/libuci.so* /usr/lib/libnl*.so*
	procd_add_jail_mount /usr/lib/ucode /usr/share/ucode/node_exporter /usr/libexec/$NAME /etc/config
	[ -n "$cert" ] && procd_add_jail_mount "$cert" "$key" /lib/libustream-*.so* /usr/lib/libustream-*.so*
	procd_set_param no_new_privs 1

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn

	procd_close_instance
}

service_triggers() {
	local interface

	procd_add_reload_trigger "$NAME"

	config_load "$NAME"
	config_get interface main listen_interface loopback

	[ "$interface" = "*" ] || procd_add_reload_interface_trigger "$interface"
}
