#!/bin/sh /etc/rc.common
# Copyright (C) 2013-2017 OpenWrt.org

START=60
USE_PROCD=1

NAME=prometheus-exporter
LIBEXEC=/usr/libexec/$NAME
# The command line: check, as this script's own check and before start and reload.
COMMAND=/usr/bin/$NAME
HANDLER=$LIBEXEC/handler.uc
COLLECTORS=/usr/share/ucode/prometheus_exporter/collectors
# The realm of basic auth, as prometheus_exporter.auth names it.
REALM=$NAME
# The exporter's state, as prometheus_exporter.state names it: the one path
# the jail mounts read-write. jail.uc --make makes it, mode 0700.
STATE=/var/run/$NAME/state
# The ubus socket, as prometheus_exporter.jail names it among the mounts of a
# collector that needs ubus: procd's jail option mounts it.
UBUS_SOCKET=/var/run/ubus/ubus.sock
# What jail.uc --make writes for the service's user, as
# prometheus_exporter.privileges names it: the capabilities ujail gives the
# jail, and the copies of the TLS files, which only root reads, readable by
# the service's group.
CAPABILITIES=/var/run/$NAME/capabilities.json
TLS_CERT=/var/run/$NAME/tls.crt
TLS_KEY=/var/run/$NAME/tls.key

extra_command "check" "Check the configuration, list the collectors and run a scrape"

# Every line the service logs has its own priority: err for what stops it (an
# invalid configuration, a directory it cannot make), warning for what it does
# without (a path the jail cannot mount), info for what it says of itself.
_log() {
	logger -p daemon.info -t "$NAME" "$@"
}

service_enabled() {
	local enabled
	config_load "$NAME"
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ]
}

# $1: what happens when the configuration is invalid
config_valid() {
	local report
	report=$("$COMMAND" check --config 2>&1) && return 0
	echo "$report" | logger -s -t "$NAME" -p daemon.err
	logger -s -t "$NAME" -p daemon.err "$1"
	return 1
}

# The bytes of data each of the exporter's processes may take (RLIMIT_DATA):
# memory_limit's MB, or a quarter of the RAM, at most 64 MB, as
# prometheus_exporter.config's memory_limit_mb() works it out.
memory_limit() {
	local mb total
	config_get mb main memory_limit 0
	[ "$mb" -gt 0 ] 2>/dev/null || {
		total=$(sed -n 's/^MemTotal: *\([0-9]*\) kB$/\1/p' /proc/meminfo)
		mb=$((${total:-0} / 1024 / 4))
		[ "$mb" -le 64 ] || mb=64
	}
	echo $((mb * 1024 * 1024))
}

# The jail's read-only mounts, one per line: the exporter's own, then those of
# the installed and enabled collectors; what cannot be mounted is logged.
jail_mounts() {
	{ "$LIBEXEC/jail.uc" 2>&1 >&3 | logger -t "$NAME" -p daemon.warn; } 3>&1
}

# Makes the directories the collectors own (textfile's) and the state
# directory, so the jail has them, and grants the service's user what the
# enabled collectors declare (the ubus ACL, capabilities, groups, read access
# to configs and proc files) and the TLS copies: what it did is logged at
# info, what it could not at err.
jail_make() {
	{ "$LIBEXEC/jail.uc" --make 2>&1 >&3 | logger -t "$NAME" -p daemon.err; } 3>&1 |
		logger -t "$NAME" -p daemon.info
}

# Takes away what only the running service needs: the ubus ACL, the
# capabilities file and the TLS copies.
jail_clean() {
	"$LIBEXEC/jail.uc" --clean 2>&1 | logger -t "$NAME" -p daemon.err
}

start_service() {
	service_enabled || { jail_clean; return 0; }
	# reload has checked it already.
	[ -n "$CONFIG_CHECKED" ] || config_valid "invalid configuration, not starting" || return 1
	# uhttpd runs as the package's user, never as root.
	user_exists "$NAME" && group_exists "$NAME" || {
		logger -t "$NAME" -p daemon.err "no user or group $NAME: reinstall the package, which makes them; not starting"
		return 1
	}

	. /lib/functions/network.sh

	local interface port keepalive cert key listen bind4 bind6 mounts missing auth data ubus

	config_get interface main listen_interface loopback
	config_get port main listen_port 9100
	config_get keepalive main http_keepalive 70
	config_get cert main cert
	config_get key main key

	[ "$interface" = "*" ] || {
		network_get_ipaddr bind4 "$interface"
		network_get_ipaddr6 bind6 "$interface"
		[ -n "$bind4$bind6" ] || {
			_log "deferring start until listen interface $interface becomes ready"
			return 0
		}
	}

	# Basic auth's file (uhttpd's -c), written afresh, or removed without it.
	# It is checked over HTTPS only: never served over HTTP.
	auth=$("$LIBEXEC/auth.uc" 2>&1) || {
		echo "$auth" | logger -t "$NAME" -p daemon.err
		logger -t "$NAME" -p daemon.err "cannot set up basic auth, not starting"
		return 1
	}
	[ -z "$auth" ] || { [ -f "$cert" ] && [ -f "$key" ]; } || {
		logger -t "$NAME" -p daemon.err "basic auth takes HTTPS only, and $cert or $key is missing: not starting"
		return 1
	}

	jail_make
	mounts=$(jail_mounts)
	[ -n "$mounts" ] || {
		logger -t "$NAME" -p daemon.err "cannot work out the jail's mounts, not starting"
		return 1
	}
	missing=$("$LIBEXEC/jail.uc" --missing 2>/dev/null)

	procd_open_instance

	procd_set_param command /usr/sbin/uhttpd -f -c "${auth:-/dev/null}" -h /dev/null -S -D -o /metrics -O "$HANDLER"
	[ -z "$auth" ] || procd_append_param command -r "$REALM"
	# Always: without -k uhttpd keeps its own 20 seconds, and -k 0 closes each
	# connection once it has answered.
	procd_append_param command -k "$keepalive"
	# The seconds uhttpd gives a scrape before it kills it, answering nothing:
	# its own default, said here, as the exporter caps a scrape's deadline by
	# it (prometheus_exporter.config's SCRIPT_TIMEOUT).
	procd_append_param command -t 60
	# What uhttpd serves at once, said rather than left to its defaults (3
	# and 100). Its scrapers are one or two Prometheus servers, each keeping
	# a connection to it (-k) and scraping on it once an interval; LuCI
	# reaches the exporter through rpcd, not here. 3 requests run at once:
	# two scrapers' scrapes that overlap, and one more, a person's curl. Each
	# is a full scrape, or with basic auth a hash's check first; one past
	# them waits for its turn. And 10 connections: those of the scrapers,
	# and room for a few more, which bounds the requests that can wait.
	procd_append_param command -n 3 -N 10

	# The copies jail.uc --make made, which the service's group reads.
	if [ -f "$cert" ] && [ -f "$key" ]; then
		listen=-s
		procd_append_param command -C "$TLS_CERT" -K "$TLS_KEY"
	else
		listen=-p
	fi

	if [ "$interface" = "*" ]; then
		procd_append_param command $listen "$port"
	else
		[ -n "$bind4" ] && procd_append_param command $listen "$bind4:$port"
		[ -n "$bind6" ] && procd_append_param command $listen "[$bind6]:$port"
	fi

	# The exporter's code and libraries, then what its collectors declare
	# (jail.uc's; its globs expand here). The ubus socket only when one of
	# them needs ubus: the jail's option mounts it, not a mount of its own.
	echo "$mounts" | grep -qx "$UBUS_SOCKET" && ubus=ubus
	procd_add_jail "$NAME" log procfs sysfs $ubus
	procd_add_jail_mount $(echo "$mounts" | grep -vx "$UBUS_SOCKET")
	[ "$listen" = -s ] && procd_add_jail_mount "$TLS_CERT" "$TLS_KEY" /lib/libustream-*.so* /usr/lib/libustream-*.so*
	[ -n "$auth" ] && procd_add_jail_mount "$auth"
	# What the handler keeps between requests (basic auth's cache), on tmpfs;
	# each instance its own, so a restart starts without it.
	procd_add_jail_mount_rw "$STATE"
	procd_set_param no_new_privs 1
	# Not root: the package's user and group, held by ubusd to the ACL
	# jail.uc --make wrote, with the capabilities of the enabled collectors
	# alone (none, mostly), in every set, so a program it runs has them too.
	procd_set_param user "$NAME"
	procd_set_param group "$NAME"
	procd_set_param capabilities "$CAPABILITIES"

	# What a collector may take of the router. Each of uhttpd's processes,
	# the scrapes and the child processes their collectors run in, may take
	# this much data: past it an allocation fails, and ucode aborts the
	# process, a collector's child alone (prometheus_exporter.runner). And
	# the exporter yields the CPU to the router's own work (hostapd,
	# dnsmasq, netifd), which a scrape never competes with.
	data=$(memory_limit)
	procd_set_param limits data="$data $data"
	procd_set_param nice 10

	# The jail binds files, which keep their old contents when a new file
	# replaces them, as uci commit does: so a reload restarts the instance
	# when a config it reads, a collector, basic auth's file, the TLS files
	# (a renewed certificate) or the capabilities change, or the TLS files
	# come to be.
	procd_set_param file $(echo "$mounts" | grep '^/etc/config/') "$COLLECTORS"/*.uc $auth ${cert:+"$cert"} ${key:+"$key"} "$CAPABILITIES"

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn

	procd_close_instance

	# The jail leaves out a path a collector reads that is not there yet, such
	# as unbound's socket directory, which unbound makes when it starts (after
	# this service, at boot). The watch instance waits for it, and sends the
	# event that reloads the service, which then mounts it. It runs as root,
	# unjailed: sending procd an event takes procd's service event, which the
	# service's ACL does not grant, as it would let the jail send any.
	[ -n "$missing" ] || return 0

	procd_open_instance watch
	procd_set_param command "$LIBEXEC/watch.uc" $missing
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

service_stopped() {
	jail_clean
}

# An invalid configuration keeps the running instance. Otherwise start again:
# procd restarts the instance only if its command, mounts or files changed.
reload_service() {
	if service_enabled; then
		config_valid "invalid configuration, keeping the running instance" || return 1
		CONFIG_CHECKED=1
	fi
	start
}

# Its own config, basic auth's hash's, and those its collectors read.
service_triggers() {
	local interface configs

	configs=$("$LIBEXEC/jail.uc" 2>/dev/null | sed -n "s|^/etc/config/||p" | grep -vx "$NAME")
	procd_add_reload_trigger "$NAME" "$NAME-auth" $configs
	# From the watch instance, when a missing path is there.
	procd_add_raw_trigger "$NAME.path" 1000 "/etc/init.d/$NAME" reload

	config_load "$NAME"
	config_get interface main listen_interface loopback

	[ "$interface" = "*" ] || procd_add_reload_interface_trigger "$interface"
}

status_service() {
	local code
	_procd_status "$NAME" "$1"
	code=$?
	if ! service_enabled; then
		echo "disabled (option enabled in /etc/config/$NAME)"
	elif [ "$code" = 0 ] && service_running; then
		"$LIBEXEC/status.uc"
	fi
	return "$code"
}

check() {
	"$COMMAND" check
}
