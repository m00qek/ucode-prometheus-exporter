# Based on utils/prometheus-node-exporter-ucode/files/config in OpenWrt's
# packages feed (Apache-2.0); see NOTICE.

config prometheus-exporter 'main'
	# '0': the service does not run.
	option enabled '1'
	option listen_interface 'loopback'
	option listen_port '9100'
	option http_keepalive '70'
	# Leave out counters that are 0, most of which never move on a router.
	option omit_zero_values '0'
	# Seconds the programs a collector runs get in all in each scrape (1-30),
	# unless the collector says otherwise.
	option exec_timeout '5'
	# Seconds a scrape has to answer (1-60) when the scraper does not say;
	# Prometheus and vmagent say, in X-Prometheus-Scrape-Timeout-Seconds.
	option scrape_timeout '10'
	# Seconds a collector may take in a scrape (1-60) before it is quarantined
	# for a few scrapes, unless the collector says otherwise.
	option collector_budget '5'
	# Samples a collector may write in a scrape (1-100000): one that writes
	# more fails, and none of its samples are served, unless it says otherwise.
	option max_samples '20000'
	# Samples the collectors of a scrape may write in all (1-1000000): a
	# collector whose samples would go past it fails, and none of its are served.
	option max_scrape_samples '200000'
	# '0': never gzip a scrape; otherwise it is, when the scraper asks for it.
	option compress '1'
	# Serve HTTPS: both files must exist, and uhttpd needs a TLS library.
	#option cert '/etc/uhttpd.crt'
	#option key '/etc/uhttpd.key'
	# Basic auth, over HTTPS only: a user, with the crypt hash of its password
	# in /etc/config/prometheus-exporter-auth.
	#option auth_user 'prometheus'

# A collector's section is named after its module ('ltq_dsl' for ltq-dsl) and
# is optional: without one, the collector runs with its default options.
# Every collector has enabled; '0' stops serving it. One that runs programs
# (ethtool, nft-counters, modemmanager, ubnt-manager) also has timeout, which
# overrides exec_timeout for it.
#config collector 'wifi'
#	option stations '1'
#config collector 'ltq_dsl'
#	option enabled '0'
#config collector 'ubnt_manager'
#	option timeout '10'
