[ -n "$stratum" ] || exit 0

dir=/var/run/prometheus-exporter
state=$dir/timesync/ntpd

[ -d "$dir" ] || mkdir -m 0700 "$dir" || exit 0
[ -d "$dir/timesync" ] || mkdir "$dir/timesync" || exit 0

tmp=$(mktemp "$state.XXXXXX") || exit 0
if printf 'time=%s\naction=%s\nstratum=%s\noffset=%s\nfreq_drift_ppm=%s\npoll_interval=%s\n' \
	"$(date +%s)" "$ACTION" "$stratum" "$offset" "$freq_drift_ppm" "$poll_interval" >"$tmp" &&
	chmod 0644 "$tmp" && mv -f "$tmp" "$state"; then
	:
else
	rm -f "$tmp"
fi
