{
	"prometheus-exporter": {
		"instances": {
			"instance1": {
				"running": true,
				"pid": 4242,
				"command": [
					"/usr/sbin/uhttpd", "-f", "-c", "/dev/null", "-h", "/dev/null", "-S", "-D", "-o", "/metrics",
					"-O", "/usr/libexec/prometheus-exporter/handler.uc", "-k", "70",
					"-p", "127.0.0.1:9100", "-p", "[::1]:9100"
				],
				"term_timeout": 5,
				"respawn": { "threshold": 3600, "timeout": 5, "retry": 5 },
				"jail": { "name": "prometheus-exporter", "procfs": true, "sysfs": true, "ubus": true, "log": true }
			}
		}
	}
}
